    "Mixtape cannot share widget data. Signing must allow the same shared group for the app and its extension.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixtape cannot share widget data. Signing must allow the same shared group for the app and its extension."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixtape ne peut pas partager ses données avec les widgets. La signature doit autoriser le même groupe partagé pour l’application et son extension."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixtape ne peut pas partager ses données avec les widgets. La signature doit autoriser le même groupe partagé pour l’application et son extension."
          }
        }
      }
    },
    "Widget data could not be saved. Try refreshing the widgets.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget data could not be saved. Try refreshing the widgets."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données des widgets n’ont pas pu être enregistrées. Essayez de les actualiser."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données des widgets n’ont pas pu être enregistrées. Essayez de les actualiser."
          }
        }
      }
    },
    "A publication confirms the app saved its data. An extension read confirms a widget accessed it. iOS controls when widgets refresh.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A publication confirms the app saved its data. An extension read confirms a widget accessed it. iOS controls when widgets refresh."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une publication confirme que l’application a enregistré ses données. Une lecture par l’extension confirme qu’un widget y a accédé. iOS décide du moment des actualisations."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Une publication confirme que l’application a enregistré ses données. Une lecture par l’extension confirme qu’un widget y a accédé. iOS décide du moment des actualisations."
          }
        }
      }
    },
    "After installing, open Mixtape and play a song. In Sideloadly, keep the widget extension enabled.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After installing, open Mixtape and play a song. In Sideloadly, keep the widget extension enabled."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après l’installation, ouvrez Mixtape et écoutez un titre. Dans Sideloadly, conservez l’extension des widgets."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Après l’installation, ouvrez Mixtape et écoutez un titre. Dans Sideloadly, conservez l’extension des widgets."
          }
        }
      }
    }
  },
  "version": "1.0"
}
